#!/usr/bin/env bash
# git takes any unambiguous prefix of a long option, so a prefix of a blocked one is refused too.
blocked="output contents config-env exec-path git-dir work-tree ext-diff textconv no-index ignore-revs-file"
branch_blocked="delete move copy force set-upstream-to unset-upstream edit-description"
# `git branch NAME` creates a ref, so branch only takes a name after a flag that reads.
branch_reads="--list -l --contains --no-contains --merged --no-merged --points-at --format --sort"
refuse() { echo "git $1 is not allowed during a klaussy review" >&2; exit 1; }
sub=""
prev=""
listing=""
for arg in "$@"; do
  [ "$arg" = "--" ] && break
  case " --list -l " in *" $arg "*) [ "$sub" = branch ] && listing=1 ;; esac
  if [ "$sub" = branch ] && [ "${arg#-}" = "$arg" ] && [ -z "$listing" ]; then
    case " $branch_reads " in *" $prev "*) ;; *) refuse "branch $arg" ;; esac
  fi
  prev="$arg"
  name="${arg%%=*}"
  case "$name" in
    --?*)
      list="$blocked"
      [ "$sub" = branch ] && list="$list $branch_blocked"
      for b in $list; do
        case "$b" in "${name#--}"*) refuse "$arg" ;; esac
      done ;;
    -c*|-C*) refuse "$arg" ;;
    -*S*) [ "$sub" = blame ] && refuse "$arg" ;;
    -*[dDmMfu]*) [ "$sub" = branch ] && refuse "$arg" ;;
  esac
  [ -z "$sub" ] && [ "${arg#-}" = "$arg" ] && sub="$arg"
done
exec REAL_GIT --no-replace-objects "$@"
